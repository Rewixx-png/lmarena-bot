# === Telegram ===
# Token бота от @BotFather (обязательно).
BOT_TOKEN=

# Канал для уведомлений: "@mychannel" или числовой id вида "-1001234567890".
# Пусто — уведомления в канал отключены.
CHANNEL_ID=

# Личка администратора для уведомлений (id или @username). Пусто — отключено.
ADMIN_CHAT_ID=

# === Мониторинг ===
# Интервал проверки лидерборда, секунды (по умолчанию 180).
CHECK_INTERVAL_SECONDS=180

# === Пороги diff-движка ===
# Минимальное изменение Elo для события STATS_UPDATE.
ELO_CHANGE_THRESHOLD=5.0
# Минимальный сдвиг в ранге для события STATS_UPDATE.
RANK_CHANGE_THRESHOLD=3
# Уведомлять об изменениях статистики только для моделей в топе (<= N).
STATS_NOTIFY_TOP_N=40

# === Прочее ===
DATABASE_PATH=arena.db
